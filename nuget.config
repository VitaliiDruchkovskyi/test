<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for BenefitNetFlex (CI and developer machines).

  The single source is the Azure Artifacts feed "benefitnetflex", which has nuget.org as an
  upstream source. Every package restored through it is saved in the feed, so builds keep
  working when nuget.org (or a package) is unavailable.

  Replace YOUR_ORG and YOUR_PROJECT with your Azure DevOps organization and project.
  Developers: Visual Studio authenticates automatically; for the command line install the
  Azure Artifacts Credential Provider (https://github.com/microsoft/artifacts-credprovider).
  See docs/pipeline/setup.md § 7.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="benefitnetflex" value="https://pkgs.dev.azure.com/YOUR_ORG/YOUR_PROJECT/_packaging/benefitnetflex/nuget/v3/index.json" />
    <!-- External feed that needs credentials (if any). In CI, authorize it with a NuGet
         service connection passed to nuGetServiceConnections in azure-pipelines.yml.
    <add key="vendor" value="https://nuget.vendor.example/v3/index.json" />
    -->
  </packageSources>
</configuration>
